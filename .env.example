# Copiar a .env y establecer dos contraseñas diferentes antes de usar Compose.
# El archivo .env es leído por Docker Compose; Java/Jetty no lo carga automáticamente.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# Para ejecución Java directa: exportar estas variables al proceso.
APP_ENV=development
DB_MODE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinica_db
DB_USER=clinica_app
DB_SSL_MODE=REQUIRED

# En producción: APP_ENV=production y DB_SSL_MODE=VERIFY_IDENTITY.
# Si la CA no está en el almacén de confianza de Java, montar el truststore fuera de la imagen.
# DB_TRUSTSTORE_PATH=/run/certs/mysql-truststore.p12
# DB_TRUSTSTORE_TYPE=PKCS12
# DB_TRUSTSTORE_PASSWORD=

ADMISION_TOLERANCIA_MINUTOS=10
CONFIRMACION_CITA_HORAS_ANTES=24
