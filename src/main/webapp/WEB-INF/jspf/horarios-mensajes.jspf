<%@ page pageEncoding="UTF-8" %>
<c:if test="${not empty sessionScope.horariosMensaje}"><p class="hor-mensaje" role="status"><c:out value="${sessionScope.horariosMensaje}"/></p><c:remove var="horariosMensaje" scope="session"/></c:if>
<c:if test="${not empty sessionScope.horariosError}"><p class="hor-error" role="alert"><c:out value="${sessionScope.horariosError}"/></p><c:remove var="horariosError" scope="session"/></c:if>
