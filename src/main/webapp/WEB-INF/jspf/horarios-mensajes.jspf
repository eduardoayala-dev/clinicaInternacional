<%@ page pageEncoding="UTF-8" %>
<c:if test="${not empty sessionScope.horariosMensaje}"><output class="hor-mensaje" aria-live="polite"><c:out value="${sessionScope.horariosMensaje}"/></output><c:remove var="horariosMensaje" scope="session"/></c:if>
<c:if test="${not empty sessionScope.horariosError}"><p class="hor-error" role="alert"><c:out value="${sessionScope.horariosError}"/></p><c:remove var="horariosError" scope="session"/></c:if>
