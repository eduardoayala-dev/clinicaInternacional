<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,pe.edu.utp.clinica.dao.CatalogoSedesDAO,pe.edu.utp.clinica.util.Html" %>
<% List<CatalogoSedesDAO.Sede> sedes=(List<CatalogoSedesDAO.Sede>)request.getAttribute("sedesCatalogo"); %>
<!DOCTYPE html><html lang="es"><head><%@ include file="/WEB-INF/jspf/csrf-head.jspf" %>
<meta name="viewport" content="width=device-width,initial-scale=1"><title>Sedes</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/portal-administrativo.css?v=20261104-admin2">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/sysadmin-shell.css?v=20261104-admin2">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/catalogo-sedes.css?v=20261104-admin2">
</head><body class="sysadmin-portal"><%@ include file="/WEB-INF/jspf/sysadmin-sidebar.jspf" %>
<main class="adm-main-wrapper"><header class="adm-topbar"><span class="adm-breadcrumb">Administrador / Sedes</span></header><div class="adm-content-scroll">
<div class="sedes-heading"><div><h1 class="adm-page-title">Sedes</h1><p class="adm-page-subtitle">Gestiona los datos de contacto y el estado de las sedes clínicas.</p></div><button type="button" class="adm-btn-primary" data-abrir-dialog="nuevaSede">Nueva sede</button></div>
<% for(String atributo:new String[]{"mensajeSedes","errorSedes"}){Object mensaje=session.getAttribute(atributo);if(mensaje!=null){ %><p role="status" class="sedes-mensaje <%= atributo.equals("errorSedes")?"sedes-error":"" %>"><%= Html.texto(mensaje) %></p><% session.removeAttribute(atributo);}} %>
<section class="sedes-tarjeta"><div class="sedes-toolbar"><label for="buscarSede">Buscar sede<input id="buscarSede" type="search" placeholder="Nombre, código o dirección"></label><label for="estadoSede">Estado<select id="estadoSede"><option value="">Todos los estados</option><option value="ACTIVO">Activo</option><option value="INACTIVO">Inactivo</option><option value="MANTENIMIENTO">Mantenimiento</option></select></label><a class="adm-btn-outline" href="?accion=exportar">Exportar Excel</a></div>
<div class="sedes-tabla"><table><thead><tr><th>Código</th><th>Sede</th><th>Dirección</th><th>Teléfono</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
<% for(var sede:sedes){ %><tr class="sede-fila" data-busqueda="<%= Html.texto(sede.codigo()+" "+sede.nombre()+" "+sede.direccion()) %>" data-estado="<%= Html.texto(sede.estado()) %>"><td><%= Html.texto(sede.codigo()) %></td><td><strong><%= Html.texto(sede.nombre()) %></strong></td><td><%= Html.texto(sede.direccion()) %></td><td><%= Html.texto(sede.telefono()) %></td><td><span class="sede-estado"><%= Html.texto(sede.estado()) %></span></td><td><button type="button" class="adm-btn-outline" data-abrir-dialog="editarSede<%= sede.id() %>">Editar</button></td></tr><% } %>
<tr id="sedesVacias" hidden><td colspan="6">No hay sedes para los filtros seleccionados.</td></tr></tbody></table></div>
<div class="sedes-paginacion"><span id="cantidadSedes" role="status"><%= sedes.size() %> sedes registradas</span><div><button type="button" class="adm-btn-outline" id="sedesAnterior">Anterior</button><span id="paginaSedes"></span><button type="button" class="adm-btn-outline" id="sedesSiguiente">Siguiente</button></div></div></section>
<details class="sedes-tarjeta sedes-importar"><summary>Importar sedes desde Excel</summary><p>Descarga la plantilla. El archivo crea sedes nuevas o actualiza las existentes por código; muestra el resultado de cada fila.</p><a class="adm-btn-outline" href="?accion=plantilla">Descargar plantilla</a>
<form method="post" enctype="multipart/form-data" action="${pageContext.request.contextPath}/sysadmin/catalogo-sedes" class="sedes-formulario sedes-archivo"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="accion" value="importar"><label for="archivoSedes">Archivo XLSX, máximo 1 MB y 200 filas<input id="archivoSedes" type="file" name="archivo" accept=".xlsx" required></label><button class="adm-btn-primary" type="submit">Importar archivo</button></form></details>
<% Object reporte=session.getAttribute("resultadoSedes");if(reporte instanceof List){ %><section class="sedes-tarjeta"><h2>Resultado de la importación</h2><ul><% for(Object objeto:(List<?>)reporte){CatalogoSedesDAO.Fila fila=(CatalogoSedesDAO.Fila)objeto; %><li>Fila <%= fila.numero() %>: <%= Html.texto(fila.resultado()) %></li><% } %></ul></section><% session.removeAttribute("resultadoSedes");} %>
<% for(int indice=-1;indice<sedes.size();indice++){boolean nueva=indice<0;var sede=nueva?new CatalogoSedesDAO.Sede(0,"","","","","ACTIVO"):sedes.get(indice);String dialogo=nueva?"nuevaSede":"editarSede"+sede.id(); %>
<dialog id="<%= dialogo %>" class="sedes-dialog" aria-labelledby="titulo<%= dialogo %>"><div class="sedes-heading"><h2 id="titulo<%= dialogo %>"><%= nueva?"Nueva sede":"Editar sede" %></h2><button type="button" class="adm-btn-outline" data-cerrar-dialog aria-label="Cerrar formulario">Cerrar</button></div>
<form method="post" action="${pageContext.request.contextPath}/sysadmin/catalogo-sedes" class="sedes-formulario"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="accion" value="guardar"><input type="hidden" name="id" value="<%= sede.id() %>">
<label>Nombre<input name="nombre" value="<%= Html.texto(sede.nombre()) %>" required minlength="3" maxlength="100" data-nombre-sede></label><label>Código<input name="codigo" value="<%= Html.texto(sede.codigo()) %>" readonly placeholder="Se genera al guardar" maxlength="20"><small><%= nueva?"Basado en las iniciales. Si ya existe, se añade un número.":"Código permanente de la sede." %></small></label><label class="sedes-campo-ancho">Dirección<input name="direccion" value="<%= Html.texto(sede.direccion()) %>" required minlength="5" maxlength="255"></label><label>Teléfono<input name="telefono" value="<%= Html.texto(sede.telefono()) %>" required minlength="6" maxlength="20"></label><label>Estado<select name="estado"><% for(String estado:new String[]{"ACTIVO","INACTIVO","MANTENIMIENTO"}){ %><option value="<%= estado %>" <%= estado.equals(sede.estado())?"selected":"" %>><%= estado %></option><% } %></select></label><div class="sedes-footer sedes-campo-ancho"><button type="button" class="adm-btn-outline" data-cerrar-dialog>Cancelar</button><button type="submit" class="adm-btn-primary"><%= nueva?"Crear sede":"Guardar cambios" %></button></div></form></dialog><% } %>
</div></main><script src="${pageContext.request.contextPath}/assets/js/catalogo-sedes.js?v=20261104-admin2"></script></body></html>