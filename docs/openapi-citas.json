{
  "openapi": "3.1.0",
  "info": {
    "title": "API de gestión de citas",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/api/medicos": {
      "get": {
        "summary": "Consultar médicos",
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "idEspecialidad",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "idSede",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/api/horarios": {
      "get": {
        "summary": "Consultar horarios",
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "idMedico",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "fecha",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/citas": {
      "get": {
        "summary": "Consultar próximas citas propias",
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          }
        },
        "parameters": [],
        "security": [
          {
            "sesionServlet": []
          },
          {
            "sesionJwt": []
          }
        ]
      },
      "post": {
        "summary": "Reservar un cupo retenido",
        "responses": {
          "201": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          }
        },
        "parameters": [],
        "security": [
          {
            "sesionServlet": [],
            "csrf": []
          },
          {
            "sesionJwt": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "idMedico",
                  "fecha",
                  "hora",
                  "idMotivo",
                  "retencion"
                ],
                "properties": {
                  "idMedico": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "fecha": {
                    "type": "string"
                  },
                  "hora": {
                    "type": "string"
                  },
                  "idMotivo": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "retencion": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/citas/retenciones": {
      "post": {
        "summary": "Retener cupo",
        "responses": {
          "201": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          }
        },
        "parameters": [],
        "security": [
          {
            "sesionServlet": [],
            "csrf": []
          },
          {
            "sesionJwt": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "idMedico",
                  "fecha",
                  "hora"
                ],
                "properties": {
                  "idMedico": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "fecha": {
                    "type": "string"
                  },
                  "hora": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/citas/{id}/reprogramacion": {
      "post": {
        "summary": "Reprogramar cita propia",
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "security": [
          {
            "sesionServlet": [],
            "csrf": []
          },
          {
            "sesionJwt": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "idMedico",
                  "fecha",
                  "hora",
                  "idMotivo"
                ],
                "properties": {
                  "idMedico": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "fecha": {
                    "type": "string"
                  },
                  "hora": {
                    "type": "string"
                  },
                  "idMotivo": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/citas/{id}/cancelacion": {
      "post": {
        "summary": "Cancelar cita propia",
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "security": [
          {
            "sesionServlet": [],
            "csrf": []
          },
          {
            "sesionJwt": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "motivo"
                ],
                "properties": {
                  "motivo": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sesionServlet": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      },
      "sesionJwt": {
        "type": "apiKey",
        "in": "cookie",
        "name": "CLINICA_ACCESS"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "schemas": {
      "Respuesta": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        }
      }
    }
  }
}
