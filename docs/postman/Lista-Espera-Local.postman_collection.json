{
  "info": {
    "name": "Clínica - Lista de espera y ofertas locales",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Solo LOCAL. Configura correoPersonal, clavePersonal, fechaAgenda futura, idMedico, idSede e idEspecialidad. Publica una agenda, crea dos pacientes sintéticos, reserva, inscribe, cancela, comprueba propiedad y retención del cupo, acepta sin duplicar y cancela la cita sintética. No consulta servicios de DNI. Cookies activadas y redirecciones desactivadas. Conserva las cuentas sintéticas y la agenda para revisión; no modifica cuentas existentes."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "correoPersonal",
      "value": ""
    },
    {
      "key": "clavePersonal",
      "value": ""
    },
    {
      "key": "idMedico",
      "value": "1"
    },
    {
      "key": "idSede",
      "value": "1"
    },
    {
      "key": "fechaAgenda",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "idEspecialidad",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Sesión de personal",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/login/personal",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP\",()=>pm.response.to.have.status(200));",
              "const match=pm.response.text().match(/name=\"csrfToken\"\\s+value=\"([^\"]+)\"/); pm.test(\"Token CSRF\",()=>pm.expect(match).to.not.eql(null)); if(match) pm.collectionVariables.set(\"csrfToken\",match[1]);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Ingresar como personal administrativo",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/login/personal",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "csrfToken",
              "value": "{{csrfToken}}",
              "type": "text"
            },
            {
              "key": "identificador",
              "value": "{{correoPersonal}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{clavePersonal}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP\",()=>pm.response.to.have.status(302));",
              "pm.test(\"Acceso administrativo\",()=>pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/admin/dashboard\"));"
            ]
          }
        }
      ]
    },
