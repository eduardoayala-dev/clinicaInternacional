{
  "info": {
    "name": "Clínica - Contratos de catálogos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden. Pruebas de lectura y rechazos de escritura; no crea pacientes ni consulta proveedores."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "csrfToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Obtener sesión y CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/login/paciente?action=register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(200));",
              "const match=pm.response.text().match(/name=\"csrfToken\"\\s+value=\"([^\"]+)\"/);",
              "pm.test(\"Token disponible\",()=>pm.expect(match).to.not.eql(null)); if(match) pm.collectionVariables.set(\"csrfToken\",match[1]);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Médicos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/medicos?idEspecialidad=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.test(\"Contrato uniforme\",()=>pm.expect(Object.keys(body).sort()).to.eql([\"code\",\"data\",\"message\"]));",
              "pm.test(\"Metadatos\",()=>{pm.expect(body.code).to.be.a(\"string\");pm.expect(body.message).to.be.a(\"string\");});",
              "pm.test(\"Lista de médicos\",()=>{pm.expect(body.data).to.be.an(\"array\");body.data.forEach(m=>{pm.expect(m.idMedico).to.be.above(0);pm.expect(m.nombreCompleto).to.be.a(\"string\");pm.expect(m.cmp).to.be.a(\"string\");});});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Sede sin médicos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/medicos?idEspecialidad=1&idSede=2147483647"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.test(\"Contrato uniforme\",()=>pm.expect(Object.keys(body).sort()).to.eql([\"code\",\"data\",\"message\"]));",
              "pm.test(\"Metadatos\",()=>{pm.expect(body.code).to.be.a(\"string\");pm.expect(body.message).to.be.a(\"string\");});",
              "pm.test(\"Sin reemplazar sede\",()=>pm.expect(body.data).to.eql([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Falta especialidad",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/medicos"
      },
