      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/horarios?idMedico=1&fecha=2026-02-30"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(400));",
              "const body=pm.response.json();",
              "pm.test(\"Contrato uniforme\",()=>pm.expect(Object.keys(body).sort()).to.eql([\"code\",\"data\",\"message\"]));",
              "pm.test(\"Metadatos\",()=>{pm.expect(body.code).to.be.a(\"string\");pm.expect(body.message).to.be.a(\"string\");});",
              "pm.test(\"Error sin datos\",()=>pm.expect(body.data).to.eql(null));"
            ]
          }
