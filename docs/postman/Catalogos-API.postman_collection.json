    },
    {
      "name": "07 - Fechas publicadas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/horarios?idMedico=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.test(\"Contrato uniforme\",()=>pm.expect(Object.keys(body).sort()).to.eql([\"code\",\"data\",\"message\"]));",
              "pm.test(\"Metadatos\",()=>{pm.expect(body.code).to.be.a(\"string\");pm.expect(body.message).to.be.a(\"string\");});",
              "pm.test(\"Lista de fechas\",()=>{pm.expect(body.data).to.be.an(\"array\");body.data.forEach(d=>pm.expect(d).to.match(/^\\d{4}-\\d{2}-\\d{2}$/));});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Fecha pasada sin horarios",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/horarios?idMedico=1&fecha=2000-01-01"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.test(\"Contrato uniforme\",()=>pm.expect(Object.keys(body).sort()).to.eql([\"code\",\"data\",\"message\"]));",
              "pm.test(\"Metadatos\",()=>{pm.expect(body.code).to.be.a(\"string\");pm.expect(body.message).to.be.a(\"string\");});",
              "pm.test(\"Sin horarios ficticios\",()=>pm.expect(body.data).to.eql([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - POST sin CSRF",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/medicos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(403));",
              "const body=pm.response.json();",
              "pm.test(\"Contrato uniforme\",()=>pm.expect(Object.keys(body).sort()).to.eql([\"code\",\"data\",\"message\"]));",
              "pm.test(\"Metadatos\",()=>{pm.expect(body.code).to.be.a(\"string\");pm.expect(body.message).to.be.a(\"string\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - POST con CSRF",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/medicos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(405));",
              "const body=pm.response.json();",
              "pm.test(\"Contrato uniforme\",()=>pm.expect(Object.keys(body).sort()).to.eql([\"code\",\"data\",\"message\"]));",
              "pm.test(\"Metadatos\",()=>{pm.expect(body.code).to.be.a(\"string\");pm.expect(body.message).to.be.a(\"string\");});",
              "pm.test(\"Método permitido\",()=>pm.expect(pm.response.headers.get(\"Allow\")).to.eql(\"GET\"));"
            ]
          }
        }
      ]
    }
  ]
}
