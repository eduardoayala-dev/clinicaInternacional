              "pm.test(\"Metadatos\",()=>{pm.expect(body.code).to.be.a(\"string\");pm.expect(body.message).to.be.a(\"string\");});",
              "pm.test(\"Error sin datos\",()=>pm.expect(body.data).to.eql(null));"
            ]
          }
        }
      ]
    },
    {
