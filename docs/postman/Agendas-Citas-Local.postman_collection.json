{
  "info": {
    "name": "Clínica - Agendas y ciclo de citas local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Solo LOCAL. Publica una agenda 09:00–11:00 con duración de 30 minutos, crea un paciente sintético, reserva, reprograma y cancela. La agenda queda publicada para revisión manual. Configurar fechaAgenda futura, idMedico y su idSede, correoPersonal y clavePersonal. Ejecutar en orden, con cookies y sin seguir redirecciones. No consulta proveedores de DNI. No ejecutar sobre producción."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "correoPersonal",
      "value": ""
    },
    {
      "key": "clavePersonal",
      "value": ""
    },
    {
      "key": "idMedico",
      "value": "1"
    },
    {
      "key": "idSede",
      "value": "1"
    },
    {
      "key": "fechaAgenda",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "motivoId",
      "value": "1",
      "type": "string",
      "description": "ID de un motivo ACTIVO de la especialidad del médico. El valor 1 corresponde a Cardiología en el esquema inicial."
    },
    {
      "key": "retencion",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Sesión de personal",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/login/personal",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP\",()=>pm.response.to.have.status(200));",
              "const match=pm.response.text().match(/name=\"csrfToken\"\\s+value=\"([^\"]+)\"/); pm.test(\"Token CSRF\",()=>pm.expect(match).to.not.eql(null)); if(match) pm.collectionVariables.set(\"csrfToken\",match[1]);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Ingresar como personal administrativo",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/login/personal",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "csrfToken",
              "value": "{{csrfToken}}",
              "type": "text"
            },
            {
              "key": "identificador",
              "value": "{{correoPersonal}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{clavePersonal}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP\",()=>pm.response.to.have.status(302));",
              "pm.test(\"Acceso administrativo\",()=>pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/admin/dashboard\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Gestión de médicos y token renovado",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/medicos",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP\",()=>pm.response.to.have.status(200));",
              "const match=pm.response.text().match(/name=\"csrfToken\"\\s+value=\"([^\"]+)\"/); pm.test(\"Token CSRF\",()=>pm.expect(match).to.not.eql(null)); if(match) pm.collectionVariables.set(\"csrfToken\",match[1]);"
            ]
