    {
      "name": "07 - Registro sintético y token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/login/paciente?action=register",
        "header": []
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const suffix=String(Date.now()).slice(-7);pm.collectionVariables.set(\"dniPrueba\",\"9\"+suffix);pm.collectionVariables.set(\"correoPrueba\",\"agenda.\"+suffix+\"@example.test\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP\",()=>pm.response.to.have.status(200));",
              "const match=pm.response.text().match(/name=\"csrfToken\"\\s+value=\"([^\"]+)\"/); pm.test(\"Token CSRF\",()=>pm.expect(match).to.not.eql(null)); if(match) pm.collectionVariables.set(\"csrfToken\",match[1]);"
            ]
