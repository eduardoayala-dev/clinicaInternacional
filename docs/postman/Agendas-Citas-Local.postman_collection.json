    {
      "name": "04 - Publicar agenda local",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/admin/medicos",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "csrfToken",
              "value": "{{csrfToken}}",
              "type": "text"
            },
            {
              "key": "action",
              "value": "publicar_horario_medico",
              "type": "text"
            },
            {
              "key": "idMedico",
              "value": "{{idMedico}}",
              "type": "text"
            },
            {
              "key": "idSede",
              "value": "{{idSede}}",
              "type": "text"
            },
            {
              "key": "fecha",
              "value": "{{fechaAgenda}}",
              "type": "text"
            },
            {
              "key": "horaInicio",
              "value": "09:00",
              "type": "text"
            },
            {
              "key": "horaFin",
              "value": "11:00",
              "type": "text"
            },
            {
              "key": "duracion",
              "value": "30",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP\",()=>pm.response.to.have.status(302));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Verificar horarios publicados",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/horarios?idMedico={{idMedico}}&fecha={{fechaAgenda}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP\",()=>pm.response.to.have.status(200));",
              "const body=pm.response.json(); pm.test(\"Agenda disponible\",()=>{pm.expect(body.code).to.eql(\"HORARIOS_OBTENIDOS\");pm.expect(body.data).to.include(\"09:00\");pm.expect(body.data).to.include(\"09:30\");});"
            ]
          }
        }
      ]
    },
