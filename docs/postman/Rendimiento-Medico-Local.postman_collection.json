{
  "info": {
    "name": "Clínica - Rendimiento de acceso y consulta médica",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Solo laboratorio local 8083. Cada iteración crea su sesión y CSRF, inicia sesión con BCrypt real, lee datos sintéticos autorizados y cierra sesión. Requiere target/rendimiento/usuarios.csv. No reserva ni modifica citas, no llama DNI. Incluye el coste de autenticación; no representa toda la capacidad de la aplicación. Pausa de 500 ms al terminar cada iteración."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8083"
    },
    {
      "key": "correo",
      "value": ""
    },
    {
      "key": "clave",
      "value": ""
    },
    {
      "key": "fecha",
      "value": ""
    },
    {
      "key": "idMedico",
      "value": ""
    },
    {
      "key": "idPaciente",
      "value": ""
    }
  ],
  "protocolProfileBehavior": {
    "disableCookieJar": true,
    "followRedirects": false
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function rechazarDestino(mensaje) {",
          " pm.execution.skipRequest();",
          " throw new Error(mensaje);",
          "}",
          "const base = pm.variables.get('baseUrl');",
          "if (!['http://127.0.0.1:8083', 'http://localhost:8083'].includes(base)) rechazarDestino('Esta colección está limitada al laboratorio local 8083.');",
          "for (const clave of ['correo','clave','fecha','idMedico','idPaciente']) {",
          " if (!pm.variables.get(clave)) rechazarDestino('Falta el archivo de datos sintéticos: '+clave);",
          "}",
          "const ruta = pm.variables.replaceIn(pm.request.url.toString());",
          "if (!ruta.startsWith(base+'/')) rechazarDestino('Destino fuera del laboratorio.');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Abrir login",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/html"
          },
          {
            "key": "Cookie",
            "value": "JSESSIONID={{sesionCarga}}"
          }
        ],
        "url": "{{baseUrl}}/login/personal"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('sesionCarga', '');",
              "pm.variables.set('csrfCarga', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login disponible', () => pm.response.to.have.status(200));",
              "const cookie = pm.response.headers.get('Set-Cookie') || '';",
              "const sesion = cookie.match(/JSESSIONID=([^;,\\s]+)/);",
              "pm.test('El servidor crea una sesión propia', () => pm.expect(sesion).not.to.equal(null));",
              "if (!sesion) throw new Error('No se recibió JSESSIONID');",
              "pm.variables.set('sesionCarga', sesion[1]);",
              "const token = pm.response.text().match(/<meta\\s+name=\"csrf-token\"\\s+content=\"([^\"]+)\"/);",
              "pm.test('El formulario contiene CSRF', () => pm.expect(token).not.to.equal(null));",
              "if (!token) throw new Error('No se recibió CSRF');",
              "pm.variables.set('csrfCarga', token[1]);"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookieJar": true,
        "followRedirects": false
      }
    },
    {
      "name": "02 Autenticar médico",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "text/html"
          },
          {
            "key": "Cookie",
            "value": "JSESSIONID={{sesionCarga}}"
          }
        ],
        "url": "{{baseUrl}}/login/personal",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "identificador",
              "value": "{{correo}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{clave}}",
              "type": "text"
            },
            {
              "key": "csrfToken",
              "value": "{{csrfCarga}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Autenticación real, sin seguir redirecciones', () => {",
              " pm.response.to.have.status(302);",
              " pm.expect(pm.response.headers.get('Location')).to.include('/medico/agenda');",
              "});",
              "const cookie = pm.response.headers.get('Set-Cookie') || '';",
              "const sesion = cookie.match(/JSESSIONID=([^;,\\s]+)/);",
              "pm.test('El servidor crea una sesión propia', () => pm.expect(sesion).not.to.equal(null));",
              "if (!sesion) throw new Error('No se recibió JSESSIONID');",
              "pm.variables.set('sesionCarga', sesion[1]);"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookieJar": true,
        "followRedirects": false
      }
    },
    {
      "name": "03 Abrir inicio y renovar CSRF",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/html"
          },
          {
            "key": "Cookie",
            "value": "JSESSIONID={{sesionCarga}}"
          }
        ],
        "url": "{{baseUrl}}/medico/inicio"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Inicio autenticado', () => { pm.response.to.have.status(200); pm.expect(pm.response.text()).to.include('Gestionar atención actual'); });",
              "const token = pm.response.text().match(/<meta\\s+name=\"csrf-token\"\\s+content=\"([^\"]+)\"/);",
              "pm.test('El formulario contiene CSRF', () => pm.expect(token).not.to.equal(null));",
              "if (!token) throw new Error('No se recibió CSRF');",
              "pm.variables.set('csrfCarga', token[1]);"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookieJar": true,
        "followRedirects": false
      }
    },
    {
      "name": "04 Consultar agenda con datos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "JSESSIONID={{sesionCarga}}"
          }
        ],
        "url": "{{baseUrl}}/medico/agenda?fecha={{fecha}}&vista=dia"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Agenda JSON válida y del médico esperado', () => {",
              " pm.response.to.have.status(200); const body=pm.response.json();",
              " pm.expect(body.code).to.eql('AGENDA_MEDICA_OBTENIDA');",
              " pm.expect(body.data.citas.length).to.be.above(0);",
              " pm.expect(body.data.citas.every(c => Math.floor((c.idCita-300000)/100)+10000 === Number(pm.variables.get('idMedico')))).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookieJar": true,
        "followRedirects": false
      }
    },
    {
      "name": "05 Consultar mis pacientes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "JSESSIONID={{sesionCarga}}"
          }
        ],
        "url": "{{baseUrl}}/medico/pacientes?pagina=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Pacientes paginados y autorizados', () => {",
              " pm.response.to.have.status(200); const pagina=pm.response.json().data.pacientes;",
              " pm.expect(pagina.items.length).to.be.above(0); pm.expect(pagina.items.length).to.be.at.most(20);",
              " pm.expect(pagina.items.every(p => Math.floor((p.idPaciente-100000)/100)+10000 === Number(pm.variables.get('idMedico')))).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookieJar": true,
        "followRedirects": false
      }
    },
    {
      "name": "06 Consultar historial de paciente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "JSESSIONID={{sesionCarga}}"
          }
        ],
        "url": "{{baseUrl}}/medico/pacientes?idPaciente={{idPaciente}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Historial propio con una atención real de prueba', () => {",
              " pm.response.to.have.status(200); const body=pm.response.json().data;",
              " pm.expect(body.paciente.idPaciente).to.eql(Number(pm.variables.get('idPaciente')));",
              " pm.expect(body.atenciones.items.length).to.eql(1);",
              " pm.expect(body.atenciones.items[0].diagnostico).to.eql('Impresión de prueba');",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookieJar": true,
        "followRedirects": false
      }
    },
    {
      "name": "07 Consultar seguimientos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "JSESSIONID={{sesionCarga}}"
          }
        ],
        "url": "{{baseUrl}}/medico/seguimientos?pagina=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Seguimiento propio sin reserva inventada', () => {",
              " pm.response.to.have.status(200); const datos=pm.response.json().data.seguimientos.items;",
              " pm.expect(datos.length).to.eql(1); pm.expect(datos[0].idPaciente).to.eql(Number(pm.variables.get('idPaciente')));",
              " pm.expect(datos[0].idControl).to.eql(null);",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookieJar": true,
        "followRedirects": false
      }
    },
    {
      "name": "08 Cerrar sesión y pausa de usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "text/html"
          },
          {
            "key": "Cookie",
            "value": "JSESSIONID={{sesionCarga}}"
          }
        ],
        "url": "{{baseUrl}}/logout",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "csrfToken",
              "value": "{{csrfCarga}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sesión cerrada', () => { pm.response.to.have.status(302); pm.expect(pm.response.headers.get('Location')).to.include('/login'); });",
              "pm.variables.unset('sesionCarga'); pm.variables.unset('csrfCarga');",
              "setTimeout(() => {}, 500);"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookieJar": true,
        "followRedirects": false
      }
    }
  ]
}
