{
  "info": {
    "name": "Clínica - Comprobación del módulo médico local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Solo local y con cuentas y citas sintéticas. Cierra la cita idCitaPropia y registra inasistencia de idCitaInasistencia. No usar citas reales. Configura las variables, activa cookies y desactiva el seguimiento de redirecciones. Incluye texto de prueba XSS para verificar su salida segura; no consulta proveedores externos."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "correoMedico",
      "value": ""
    },
    {
      "key": "claveMedico",
      "value": ""
    },
    {
      "key": "idMedico",
      "value": ""
    },
    {
      "key": "fechaAgenda",
      "value": ""
    },
    {
      "key": "fechaVacia",
      "value": ""
    },
    {
      "key": "fechaSeguimiento",
      "value": ""
    },
    {
      "key": "idCitaPropia",
      "value": ""
    },
    {
      "key": "idCitaInasistencia",
      "value": ""
    },
    {
      "key": "idCitaAjena",
      "value": ""
    },
    {
      "key": "idCitaFutura",
      "value": ""
    },
    {
      "key": "idCitaCancelada",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Perfil sin sesión",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/medico/perfil",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Formulario del personal",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/login/personal",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const m=pm.response.text().match(/name=\"csrfToken\"\\s+value=\"([^\"]+)\"/);pm.test(\"Token de sesión\",()=>pm.expect(m).to.not.eql(null));if(m)pm.collectionVariables.set(\"csrfToken\",m[1]);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Ingresar como médico sintético",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/login/personal",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "csrfToken",
              "value": "{{csrfToken}}",
              "type": "text"
            },
            {
              "key": "identificador",
              "value": "{{correoMedico}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{claveMedico}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 302\",()=>pm.response.to.have.status(302));",
              "pm.test(\"Ruta de médico\",()=>pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/medico/agenda\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Perfil con hoja de estilos consistente",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/medico/perfil",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const m=pm.response.text().match(/name=\"csrfToken\"\\s+value=\"([^\"]+)\"/);pm.test(\"Token de sesión\",()=>pm.expect(m).to.not.eql(null));if(m)pm.collectionVariables.set(\"csrfToken\",m[1]);",
              "pm.test(\"Estilos del portal\",()=>pm.expect(pm.response.text()).to.include(\"assets/css/portal-medico.css\"));",
              "pm.test(\"Sin perfil ficticio\",()=>pm.expect(pm.response.text()).to.not.include(\"Dr. Carlos Mendoza\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Perfil real de la sesión",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/medico/perfil",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const b=pm.response.json();pm.test(\"Perfil propio\",()=>pm.expect(String(b.data.idMedico)).to.eql(String(pm.collectionVariables.get(\"idMedico\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Inicio con métricas reales",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/medico/inicio",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const d=pm.response.json().data;pm.test(\"Conteo real de sala\",()=>pm.expect(d.enEspera).to.eql(d.agenda.filter(c=>c.estado===\"EN_SALA\").length));pm.test(\"Pendientes reales\",()=>pm.expect(d.pendientes).to.eql(d.agenda.filter(c=>[\"CONFIRMADA\",\"SOLICITADA\"].includes(c.estado)).length));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Agenda por fecha y médico de la sesión",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/medico/agenda?fecha={{fechaAgenda}}&idMedico=999999",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const d=pm.response.json().data;pm.test(\"Solo citas propias\",()=>{pm.expect(d.citas.map(c=>String(c.idCita))).to.include(String(pm.collectionVariables.get(\"idCitaPropia\")));pm.expect(d.citas.map(c=>String(c.idCita))).to.not.include(String(pm.collectionVariables.get(\"idCitaAjena\")));});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Un día vacío sigue vacío",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/medico/agenda?fecha={{fechaVacia}}",
        "header": [
