  "item": [
    {
      "name": "01 - Formulario de admisión",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/login/personal",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const t=pm.response.text().match(/name=\"csrfToken\"\\s+value=\"([^\"]+)\"/);pm.test(\"Token CSRF de sesión\",()=>pm.expect(t).not.to.eql(null));if(t)pm.collectionVariables.set(\"csrfToken\",t[1]);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Iniciar sesión",
